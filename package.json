    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@astrojs/mdx": "^4.0.2",
    "@astrojs/sitemap": "^3.2.1",
    "@fontsource/bricolage-grotesque": "^5.1.1",
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/inter": "^5.1.1",
    "@tailwindcss/vite": "^4.0.0",
    "astro": "^5.1.5",
    "tailwindcss": "^4.0.0",
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.3"
  }
}
