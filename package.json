{
  "name": "admoran",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "prebuild": "node scripts/gen-frames-enum.mjs",
    "validate": "node scripts/gen-frames-enum.mjs && node --experimental-strip-types scripts/validate.mjs",
    "build": "astro check && astro build",
