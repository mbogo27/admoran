---
export interface Props {
  message?: string;
  variant?: 'primary' | 'secondary';
  size?: 'md' | 'lg';
  class?: string;
}

const {
  message = "Hi Vincent, I found admoran.com and I'd like to talk about SEO for my business.",
  variant = 'primary',
  size = 'md',
  class: className = '',
} = Astro.props;

const WHATSAPP_NUMBER = '254743747496';
const href = `https://wa.me/${WHATSAPP_NUMBER}?text=${encodeURIComponent(message)}`;

const base =
  'inline-flex items-center justify-center gap-2 rounded-full font-body font-semibold transition-colors duration-150 no-underline';
const sizes = {
  md: 'px-6 py-3 text-[0.9375rem]',
  lg: 'px-8 py-4 text-base',
};
const variants = {
  primary: 'bg-accent text-white hover:bg-ink',
  secondary: 'bg-transparent text-ink border border-line hover:border-ink hover:bg-tint',
};
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}
>
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    width="18"
    height="18"
    fill="currentColor"
    aria-hidden="true"
  >
    <path
      d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
    ></path>
    <path
      d="M12.004 2.003c-5.514 0-9.997 4.483-9.997 9.997 0 1.762.462 3.479 1.34 4.988L2 22l5.144-1.35a9.96 9.96 0 0 0 4.86 1.238h.004c5.514 0 9.997-4.483 9.997-9.997 0-2.67-1.04-5.18-2.929-7.069a9.933 9.933 0 0 0-7.072-2.919zm0 18.187h-.003a8.2 8.2 0 0 1-4.178-1.145l-.3-.178-3.05.8.814-2.973-.196-.306a8.19 8.19 0 0 1-1.257-4.388c0-4.53 3.685-8.215 8.213-8.215a8.16 8.16 0 0 1 5.812 2.407 8.16 8.16 0 0 1 2.404 5.813c0 4.53-3.685 8.185-8.259 8.185z"
    ></path>
  </svg>
  <slot>Talk on WhatsApp</slot>
</a>
