---
export interface Props {
  question: string;
  answer: string;
}

const { question, answer } = Astro.props;
---

<details class="group border-b border-line py-5">
  <summary
    class="flex cursor-pointer list-none items-center justify-between gap-4 font-heading text-lg font-semibold text-ink marker:content-none"
  >
    {question}
    <span
      aria-hidden="true"
      class="shrink-0 text-xl text-accent transition-transform duration-150 group-open:rotate-45"
      >+</span
    >
  </summary>
  <p class="mt-3 max-w-prose text-[1.0625rem] leading-relaxed text-muted">{answer}</p>
</details>
