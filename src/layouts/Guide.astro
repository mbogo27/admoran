---
// The single layout, branching on zoom. Header blocks render before
// the body; footer and frame blocks render after. Nothing is ever
// interleaved into the body — this is a hard structural constraint,
// not a style choice. See spec §5.3: content gets chunked by retrieval
// systems, and an injected block mid-section manufactures a chunk
// boundary between a claim and its supporting evidence on every page.
//
// v0.2.1 patch 1 (change order 01) reordered these blocks per zoom:
// zoom 2's children block moved below the body, relabelled "Guides in
// this section"; zoom 3's "Common questions" moved below the body too;
// a table of contents was added at zoom 2 and 3, between the H1 and
// the body.
//
// Change order 02 reworks zoom 1 specifically: a desktop sticky rail
// (StickyToc) replaces the inline TOC — zoom 1 still gets no inline
// TOC, the rail *is* the table of contents — and the children block
// moves out of the top slot into the body itself, injected at an
// author-placed `<!-- children -->` marker so the page's opening
// argument reads before the dispatch menu. A second marker,
// `<!-- three-layers -->`, injects the ThreeLayers diagram — the one
// exception to the chunk rule, since it's authored content illustrating
// the section it sits in, not an injected nav block. Zoom 2, 3 and 4
// are unchanged from change order 01.
//
// admoran build: rewritten to wrap Build A's Layout.astro (Nav + Footer +
// SEO head) instead of emitting its own <html>/<head>/<body> — spec §1.3.
// The zoom-branching body structure below is otherwise unchanged.
import Layout from './Layout.astro';
import type { GuideNode } from '../lib/graph.ts';
import { NOINDEX, SITE_TITLE, SITE_DESCRIPTION } from '../consts.ts';
import { splitOnMarker } from '../lib/markerSplit.ts';
import ParentBlock from '../components/ParentBlock.astro';
import ChildrenBlock from '../components/ChildrenBlock.astro';
import FrameBlock from '../components/FrameBlock.astro';
import ByConcern from '../components/ByConcern.astro';
import TableOfContents from '../components/TableOfContents.astro';
import StickyToc from '../components/StickyToc.astro';
import ThreeLayers from '../components/ThreeLayers.astro';

interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  node: GuideNode;
  graph: Map<string, GuideNode>;
  headings: Heading[];
  renderedHtml?: string;
}
const { node, graph, headings, renderedHtml = '' } = Astro.props;

const primary = node.primaryParent ? graph.get(node.primaryParent) : null;
const zoom4Children = node.children.filter((s) => graph.get(s)?.zoom === 4);

const CHILDREN_MARKER = '<!-- children -->';
const THREE_LAYERS_MARKER = '<!-- three-layers -->';

// Zoom 1 body split: children marker first (falls back to "render the
// whole body, then the children block at the bottom" if absent — never
// at the top, that's the state CO-02 fixes), then the three-layers
// marker inside whatever followed it.
const [beforeChildren, afterChildrenRaw] = node.zoom === 1 ? splitOnMarker(renderedHtml, CHILDREN_MARKER) : ['', null];
const hasChildrenMarker = afterChildrenRaw !== null;
const [beforeDiagram, afterDiagram] = hasChildrenMarker
  ? splitOnMarker(afterChildrenRaw as string, THREE_LAYERS_MARKER)
  : ['', null];
const hasDiagramMarker = afterDiagram !== null;

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: '/' },
    { '@type': 'ListItem', position: 2, name: 'Guides', item: '/guides/' },
    { '@type': 'ListItem', position: 3, name: node.title, item: `/guides/${node.slug}` },
  ],
};

const pageTitle = `${node.title} | ${SITE_TITLE} Guides`;
const pageDescription = node.description || node.summary || SITE_DESCRIPTION;
const robots = NOINDEX || node.status !== 'published' ? 'noindex, nofollow' : 'index, follow';
---

<Layout title={pageTitle} description={pageDescription} robots={robots} jsonLd={breadcrumbSchema}>
  <div class:list={["mx-auto px-4 py-10 sm:px-6", node.zoom === 1 ? "max-w-5xl" : "max-w-3xl"]}>
    <div class:list={[node.zoom === 1 && "lg:grid lg:grid-cols-[16rem_minmax(0,1fr)] lg:gap-12"]}>
      {node.zoom === 1 && <StickyToc headings={headings} />}

      <div class="min-w-0">
        <nav class="mb-8 text-sm text-muted">
          <a class="hover:text-ink" href="/">Home</a>
          <span class="mx-1">/</span>
          <a class="hover:text-ink" href="/guides/">Guides</a>
          <span class="mx-1">/</span>
          <span class="text-ink">{node.title}</span>
        </nav>

        <main>
          <!-- Header blocks: everything here renders before the body. -->
          {node.zoom > 1 && <ParentBlock node={node} graph={graph} />}

          <h1 class="mb-6 font-heading text-3xl font-semibold text-ink">{node.title}</h1>

          {(node.zoom === 2 || node.zoom === 3) && <TableOfContents headings={headings} />}

          <!-- Body: the markdown content this page was written for. -->
          {node.zoom === 1 ? (
            hasChildrenMarker ? (
              <>
                <article class="prose"><Fragment set:html={beforeChildren} /></article>
                <ChildrenBlock title="In this guide" slugs={node.children} graph={graph} />
                <article class="prose">
                  <Fragment set:html={beforeDiagram} />
                  {hasDiagramMarker && <ThreeLayers />}
                  {hasDiagramMarker && <Fragment set:html={afterDiagram as string} />}
                </article>
              </>
            ) : (
              <>
                <article class="prose"><Fragment set:html={renderedHtml} /></article>
                <ChildrenBlock title="In this guide" slugs={node.children} graph={graph} />
              </>
            )
          ) : (
            <article class="prose">
              <slot />
            </article>
          )}

          <!-- Footer and frame blocks: everything here renders after the body. -->
          {node.zoom === 2 && <ChildrenBlock title="Guides in this section" slugs={node.children} graph={graph} />}
          {node.zoom === 3 && zoom4Children.length > 0 && (
            <ChildrenBlock title="Common questions" slugs={zoom4Children} graph={graph} />
          )}
          {node.zoom > 1 && <FrameBlock node={node} graph={graph} />}
          {node.zoom === 1 && <ByConcern node={node} graph={graph} />}
          {node.zoom === 2 && <ChildrenBlock title="Related guides" slugs={node.related} graph={graph} />}
          {node.zoom === 3 && <ChildrenBlock title="See also" slugs={node.related} graph={graph} />}
          {node.zoom === 4 && primary && (
            <ChildrenBlock title={`Back to ${primary.title}`} slugs={[primary.slug]} graph={graph} />
          )}
        </main>
      </div>
    </div>
  </div>
</Layout>
